# Project ORBIT — environment template
#
#   cp .env.example .env
#
# Then fill in the values below. Never commit the resulting .env (it is gitignored).

# ── Required ────────────────────────────────────────────────────────────────────

# OpenAI key used by the 5-pass structured extractor and by both dashboard
# generators. Required for anything that calls an LLM.
OPENAI_API_KEY=sk-your-key-here


# ── Google Cloud (required only when running against GCS, not for local dev) ────

# GCP project hosting the buckets, Cloud Run jobs and secrets.
GCP_PROJECT_ID=gen-lang-client-0653324487

# Bucket the API reads payloads and structured data from. When unset, the API
# falls back to local disk under data/ and logs which mode it is using.
GCS_BUCKET_NAME=

# Path to a service-account JSON key. Leave unset to use Application Default
# Credentials (`gcloud auth application-default login`), which is preferred locally.
GOOGLE_APPLICATION_CREDENTIALS=


# ── Application wiring ─────────────────────────────────────────────────────────

# Base URL the Streamlit frontend uses to reach the FastAPI backend.
# Local:  http://localhost:8000
# Docker: http://api:8000   (set automatically by docker-compose)
API_BASE=http://localhost:8000


# ── Model selection (optional — sensible defaults are built in) ─────────────────

# LLM used by the RAG pipeline. Defaults to gpt-4o-mini.
# Do not set this to plain "gpt-4": that is the legacy 8k-context model and
# top_k=15 retrieved chunks plus the system prompt can exceed its window.
RAG_LLM_MODEL=gpt-4o-mini

# Embedding model for the vector index. Runs locally via sentence-transformers,
# so it needs no API key and incurs no per-token cost.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional HuggingFace token, only needed for gated/private embedding models.
HF_TOKEN=
